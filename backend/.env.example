# =========================================
# FlowPilot Backend Environment Variables
# =========================================
# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
# Local: mongodb://127.0.0.1:27017/flowpilot
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/flowpilot
MONGODB_URI=mongodb://127.0.0.1:27017/flowpilot

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI Providers (optional - demo mode works without them)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Default AI provider used when no explicit provider is given: openai | anthropic | deepseek | mock
AI_DEFAULT_PROVIDER=mock
# When auto mode is on, missing/without keys falls back to a simulated provider
AI_AUTO_FALLBACK=true

# Billing / Stripe (optional - mock billing when empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Demo mode
DEMO_MODE=true
DEMO_EMAIL=sarmad@flowpilot.app
DEMO_PASSWORD=Demo1234!