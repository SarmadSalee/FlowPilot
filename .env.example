# ============================================================
# FlowPilot — root environment template
# Copy to backend/.env (and optional frontend/.env) and fill in.
# Never commit real secrets. The app runs fully in demo mode
# with NO keys configured (AI + integrations are simulated).
# ============================================================

# ---- Backend: create this file as backend/.env --------------

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
# Local:   mongodb://127.0.0.1:27017/flowpilot
# Atlas:   mongodb+srv://<user>:<pass>@<cluster>/flowpilot
# If Mongo is unreachable AND DEMO_MODE=true, an in-memory
# MongoDB (mongodb-memory-server) is used automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/flowpilot

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI providers (optional — demo mode works without them)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Default provider when none is specified: openai | anthropic | deepseek | mock
AI_DEFAULT_PROVIDER=mock
# When a provider has no key configured, fall back to the simulated provider
AI_AUTO_FALLBACK=true

# Billing / Stripe (optional — mock billing when empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Demo mode
DEMO_MODE=true
DEMO_EMAIL=sarmad@flowpilot.app
DEMO_PASSWORD=Demo1234!

# ---- Frontend: create this file as frontend/.env (optional) --

# Proxied through Vite in dev ('' = use same origin).
VITE_API_URL=http://localhost:5000/api
